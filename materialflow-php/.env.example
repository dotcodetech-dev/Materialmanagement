# MaterialFlow — environment template.
# Copy to `.env` and fill in the real values. On GoDaddy, edit via cPanel File Manager.

# 'production' on the server, 'development' locally.
CI_ENVIRONMENT = production

# Your site URL, with trailing slash, e.g. https://yourdomain.com/
app.baseURL = 'https://yourdomain.com/'

# MySQL credentials from cPanel > MySQL Databases.
# GoDaddy prefixes names, e.g. username_materialflow / username_mfuser.
database.default.hostname = localhost
database.default.database = your_db_name
database.default.username = your_db_user
database.default.password = your_db_password
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
